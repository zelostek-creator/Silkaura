# Copy to .env and adjust. Never commit .env.
COMPOSE_PROJECT_NAME=silkaura

# Site
WP_PORT=8080
WP_URL=http://localhost:8080
WP_TITLE=Silkaura
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me-now
WP_ADMIN_EMAIL=admin@example.com
WP_DEBUG=1

# Database
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress-secret
DB_ROOT_PASSWORD=root-secret

# Store defaults
WC_COUNTRY=US:CA
WC_CURRENCY=USD

# phpMyAdmin / Mailpit
PMA_PORT=8081
MAILPIT_PORT=8025
